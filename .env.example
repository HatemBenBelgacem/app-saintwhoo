# Kopieren nach .env und anpassen (.env nie ins Git)

# PostgreSQL für die lokale Entwicklung (cargo leptos watch, cargo test)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saintwhoo

# Docker (ANF-010): PostgreSQL-Container und App-Container (docker compose up --build)
# Die App im Container baut ihre DATABASE_URL selbst aus diesen Werten.
# Passwort ohne Sonderzeichen wie @ : / ? # (sonst in der URL kodieren)
POSTGRES_USER=saintwhoo
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=saintwhoo
# Port der App auf dem Rechner (3000 belegt? z. B. 3080)
APP_PORT=3000
RUST_LOG=info

# Livestream (ANF-007): leer = „Der Livestream ist zurzeit nicht verfügbar.“
# Mit dem Icecast-Container: http://localhost:8000/live
RADIO_STREAM_URL=

# Icecast-Container (docker compose up -d icecast)
ICECAST_SOURCE_PASSWORD=bitte-aendern
ICECAST_ADMIN_PASSWORD=bitte-aendern
ICECAST_HOSTNAME=localhost
ICECAST_MOUNT=/live
ICECAST_MAX_CLIENTS=100

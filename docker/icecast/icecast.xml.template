<!-- Vorlage: entrypoint.sh ersetzt die @PLATZHALTER@ beim Start durch Umgebungsvariablen. -->
<icecast>
    <location>@ICECAST_LOCATION@</location>
    <admin>@ICECAST_ADMIN_EMAIL@</admin>
    <hostname>@ICECAST_HOSTNAME@</hostname>

    <limits>
        <clients>@ICECAST_MAX_CLIENTS@</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- Benutzer für die Quelle (z. B. BUTT, Mixxx) ist immer "source" -->
        <source-password>@ICECAST_SOURCE_PASSWORD@</source-password>
        <admin-user>admin</admin-user>
        <admin-password>@ICECAST_ADMIN_PASSWORD@</admin-password>
    </authentication>

    <!-- Player der App läuft auf einer anderen Adresse (Port 3000) -->
    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <mount type="normal">
        <mount-name>@ICECAST_MOUNT@</mount-name>
        <stream-name>Saintwhoo Radio</stream-name>
        <stream-description>Livestream von Saintwhoo</stream-description>
        <public>0</public>
    </mount>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast</basedir>
        <logdir>/var/log/icecast</logdir>
        <webroot>/usr/share/icecast/web</webroot>
        <adminroot>/usr/share/icecast/admin</adminroot>
        <alias source="/" destination="/status.xsl" />
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <!-- 4 Debug, 3 Info, 2 Warn, 1 Error -->
        <loglevel>3</loglevel>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
